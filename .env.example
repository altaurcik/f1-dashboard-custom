# -- runtime envs --

NEXT_PUBLIC_LIVE_URL=http://localhost:4000
API_URL=http://localhost:4001

# DISABLE_IFRAME=0

# TRACKING_ID=
# TRACKING_URL=

# -- build envs --

# SKIP_ENV_VALIDATION=1		# skips env validation, use for docker
# NEXT_STANDALONE=1 			# enables nextjs standalone build, use for docker
# NEXT_NO_COMPRESS=1 			# disables nextjs compression, use when using proxy compression

# Optional override for a SignalR feed you control.
# Omit to connect directly to Formula 1; anonymous telemetry can be incomplete.
# Independent, free source coverage is documented in DATA_SOURCES.md.
# F1_LIVE_WEBSOCKET_URL=

# Public Mapbox token for an identical reference basemap (optional integration pending).
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_public_token

# Local Team Radio recognition and speaker separation, server only.
# Public models; no token or paid service is required.
# WHISPER_PYTHON=path/to/.venv-whisper/Scripts/python.exe
WHISPER_MODEL=medium.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DIARIZE=1
WHISPER_MAX_SPEAKERS=2
WHISPER_SPEAKER_THRESHOLD=0.4
# HF_TOKEN= (optional saved credential; unused by the active radio pipeline)
